# Application Environment Configuration
PROJECT_NAME="Playure API"
API_V1_STR="/api/v1"
ENV="development"
DEBUG=True

# Database Configuration
# Default PostgreSQL URL format: postgresql+asyncpg://user:password@localhost:5432/playure_db
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/playure_db"

# Fallback Async SQLite (used automatically if PostgreSQL connection fails during local dev without PG server running)
SQLITE_FALLBACK_URL="sqlite+aiosqlite:///./playure_dev.db"

# Security & JWT Secret
JWT_SECRET="playure_super_secret_jwt_key_change_in_production_2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
